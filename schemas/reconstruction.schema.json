{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lyric Motion authored reconstruction analysis",
  "description": "An evidence-based request for a similar visible result, not the recovered original prompt. Runtime validation also checks timestamp containment, viewing coverage, and local evidence paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "source", "coverage", "look", "motion", "transitions", "rhythm", "semantics", "scenes", "creativePrompt", "negativePrompt", "assumptions", "technicalStack"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "title": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "range", "frame"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "range": {"$ref": "#/$defs/range"},
        "frame": {
          "type": "object", "additionalProperties": false, "required": ["width", "height"],
          "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
        },
        "region": {"anyOf": [
          {"type": "null"},
          {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}
        ]}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["visual", "audio", "lyrics", "inspectedFrames", "watchedRanges", "listenedRanges", "limitations"],
      "properties": {
        "visual": {"enum": ["not-observed", "stills", "continuous"]},
        "audio": {"enum": ["not-observed", "signal-only", "listened"]},
        "lyrics": {"enum": ["not-provided", "visible-text", "provided-text", "timed"]},
        "inspectedFrames": {"type": "array", "items": {"type": "number", "minimum": 0}},
        "watchedRanges": {"type": "array", "items": {"$ref": "#/$defs/range"}},
        "listenedRanges": {"type": "array", "items": {"$ref": "#/$defs/range"}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "look": {
      "type": "object", "additionalProperties": false, "required": ["composition", "typography", "materials", "color"],
      "properties": {"composition": {"$ref": "#/$defs/claims"}, "typography": {"$ref": "#/$defs/claims"}, "materials": {"$ref": "#/$defs/claims"}, "color": {"$ref": "#/$defs/claims"}}
    },
    "motion": {"$ref": "#/$defs/claims"},
    "transitions": {"$ref": "#/$defs/claims"},
    "rhythm": {"$ref": "#/$defs/claims"},
    "semantics": {"$ref": "#/$defs/claims"},
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["start", "end", "description", "status"],
        "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}, "description": {"type": "string", "minLength": 1}, "status": {"enum": ["observed", "inferred", "unknown"]}, "evidence": {"$ref": "#/$defs/evidence"}},
        "allOf": [{"if": {"properties": {"status": {"const": "observed"}}}, "then": {"required": ["evidence"]}}]
      }
    },
    "creativePrompt": {"type": "string", "minLength": 40, "description": "A complete, natural production request directing a similar visible result. Not an observation list or a placeholder."},
    "negativePrompt": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/claim"}, {"properties": {"status": {"enum": ["inferred", "unknown"]}}}]}},
    "technicalStack": {
      "type": "object", "additionalProperties": false, "required": ["status", "description"],
      "properties": {"status": {"enum": ["inferred", "unknown"]}, "description": {"type": "string", "minLength": 1}}
    }
  },
  "$defs": {
    "range": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}}},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "claim": {
      "type": "object", "additionalProperties": false, "required": ["description", "status"],
      "properties": {"description": {"type": "string", "minLength": 1}, "status": {"enum": ["observed", "inferred", "unknown"]}, "evidence": {"$ref": "#/$defs/evidence"}},
      "allOf": [{"if": {"properties": {"status": {"const": "observed"}}}, "then": {"required": ["evidence"]}}]
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["at", "description"],
        "properties": {"at": {"type": "number", "minimum": 0}, "until": {"type": "number", "minimum": 0}, "description": {"type": "string", "minLength": 1}, "asset": {"type": "string", "pattern": "^evidence/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.(?:png|jpg|jpeg|webp)$"}}
      }
    }
  }
}
